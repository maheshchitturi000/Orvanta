{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Azure.Core": "Warning",
      "Azure.Storage": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "extensions": {
    "queues": {
      "maxDequeueCount": 5,
      "batchSize": 4,
      "newBatchThreshold": 2,
      "visibilityTimeout": "00:00:30",
      "maxPollingInterval": "00:00:05"
    }
  },
  "functionTimeout": "00:10:00"
}
