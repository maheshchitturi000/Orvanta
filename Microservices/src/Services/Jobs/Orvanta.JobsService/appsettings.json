{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Orvanta": ""
  },
  "Jwt": {
    "Issuer": "orvanta-auth",
    "Audience": "orvanta-api",
    "SigningKey": "",
    "EncryptionKey": ""
  },
  "Jobs": {
    "QueueConnectionString": "UseDevelopmentStorage=true",
    "DefaultMatchThreshold": 80,
    "MaxNewMatchesPerRun": 40,
    "DefaultBoards": [
      "greenhouse:okta",
      "greenhouse:databricks",
      "greenhouse:zscaler",
      "greenhouse:mongodb",
      "greenhouse:gitlab",
      "greenhouse:hackerrank",
      "greenhouse:druva",
      "greenhouse:rubrik",
      "greenhouse:twilio",
      "greenhouse:stripe",
      "greenhouse:inmobi",
      "lever:meesho",
      "lever:zeta",
      "ashby:sarvam"
    ],
    "JSearch": {
      "Enabled": true,
      "ApiKey": "",
      "BaseUrl": "https://jsearch.p.rapidapi.com",
      "Host": "jsearch.p.rapidapi.com",
      "SearchPath": "/search-v2",
      "MaxQueriesPerRun": 3,
      "PagesPerQuery": 1,
      "DatePosted": "week",
      "CacheHours": 6
    },
    "Adzuna": {
      "Enabled": true,
      "BaseUrl": "https://api.adzuna.com/v1/api/jobs",
      "DefaultCountry": "in",
      "ResultsPerPage": 50,
      "MaxDaysOld": 14
    },
    "Llm": {
      "Provider": "ollama",
      "BaseUrl": "http://localhost:11434/",
      "Model": "qwen3:4b",
      "TimeoutSeconds": 60
    }
  }
}
