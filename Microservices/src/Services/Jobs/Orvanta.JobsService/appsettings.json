{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "JobsDb": ""
  },
  "Jwt": {
    "Issuer": "orvanta-auth",
    "Audience": "orvanta-api",
    "SigningKey": "",
    "EncryptionKey": ""
  },
  "Jobs": {
    "QueueConnectionString": "UseDevelopmentStorage=true",
    "DefaultMatchThreshold": 80,
    "MaxNewMatchesPerRun": 40,
    "DefaultBoards": [
      "greenhouse:stripe",
      "greenhouse:gitlab",
      "greenhouse:cloudflare",
      "greenhouse:airbnb",
      "greenhouse:dropbox",
      "lever:spotify",
      "lever:palantir",
      "ashby:openai",
      "ashby:notion",
      "ashby:ramp",
      "ashby:linear"
    ],
    "JSearch": {
      "Enabled": true,
      "ApiKey": "",
      "BaseUrl": "https://jsearch.p.rapidapi.com",
      "Host": "jsearch.p.rapidapi.com",
      "MaxQueriesPerRun": 3,
      "PagesPerQuery": 1,
      "DatePosted": "week",
      "CacheHours": 6
    },
    "Llm": {
      "Provider": "ollama",
      "BaseUrl": "http://localhost:11434/",
      "Model": "qwen3:4b",
      "TimeoutSeconds": 120
    }
  }
}
