{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-credentials": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Order": 1,
        "Match": { "Path": "/api/auth/{action:regex(^(login|register|verify-otp|resend-otp|forgot-password|verify-reset-code|reset-password)$)}" }
      },
      "auth": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "api",
        "Order": 2,
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "integrations": {
        "ClusterId": "food",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/integrations/{**catch-all}" }
      },
      "integrations-root": {
        "ClusterId": "food",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/integrations" }
      },
      "food": {
        "ClusterId": "food",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/food/{**catch-all}" }
      },
      "ondc": {
        "ClusterId": "food",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/ondc/{**catch-all}" }
      },
      "ondc-network": {
        "ClusterId": "food",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/ondc/{**catch-all}" }
      },
      "ondc-site-verification": {
        "ClusterId": "food",
        "Match": { "Path": "/ondc-site-verification.html" }
      },
      "jobs": {
        "ClusterId": "jobs",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/jobs/{**catch-all}" }
      },
      "chat": {
        "ClusterId": "ai",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/chat/{**catch-all}" }
      },
      "chat-root": {
        "ClusterId": "ai",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/chat" }
      },
      "conversations": {
        "ClusterId": "conversation",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/conversations/{**catch-all}" }
      },
      "conversations-root": {
        "ClusterId": "conversation",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/conversations" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "primary": { "Address": "http://localhost:5101/" } }
      },
      "food": {
        "Destinations": { "primary": { "Address": "http://localhost:5077/" } }
      },
      "jobs": {
        "Destinations": { "primary": { "Address": "http://localhost:5081/" } }
      },
      "ai": {
        "Destinations": { "primary": { "Address": "http://localhost:5212/" } }
      },
      "conversation": {
        "Destinations": { "primary": { "Address": "http://localhost:5005/" } }
      }
    }
  }
}
